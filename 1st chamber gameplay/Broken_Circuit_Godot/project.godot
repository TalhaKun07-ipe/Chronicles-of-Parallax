; Standalone chamber demo. To merge, copy only chambers/broken_circuit/.
config_version=5

[application]
config/name="Degrees of Escape — The Broken Circuit"
run/main_scene="res://chambers/broken_circuit/Demo.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0784,0.0471,0.0157,1)
