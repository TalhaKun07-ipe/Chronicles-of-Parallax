; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Degrees of Escape"
config/tags=PackedStringArray("game_jam", "puzzle", "pixel_art", "degrees_of_freedom")
run/main_scene="res://scenes/ui/IntroCutscene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0470588, 0.054902, 0.0862745, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/ancient_watch_hud.png"

[autoload]

Global="*res://scripts/autoload/Global.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"
SceneTransition="*res://scripts/autoload/SceneTransition.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

